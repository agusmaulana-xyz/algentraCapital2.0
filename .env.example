# Required for local development. Replace both placeholders before starting.
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
APP_ENV=development
COOKIE_SECURE=false

# Add keys only for integrations you use.
EA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CS_API_KEY=
GEMINI_CS_MODEL=gemini-3.8-flash
GEMINI_CS_TIMEOUT_SECONDS=60
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
COPIER_WORKER_API_KEY=

# Turnstile CAPTCHA. Development defaults to Cloudflare's public test keys.
# Production requires a real key pair from a Cloudflare Turnstile widget.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AirPay QRIS checkout. The API key remains server-side and is never sent to browsers.
AIRPAY_BASE_URL=https://airpaygateway.site
AIRPAY_API_KEY=
AIRPAY_MERCHANT_UID=

# Optional email settings. Fill all four to enable email features.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_SMTP_STARTTLS=true

# Optional public contact details.
CONTACT_PERSON_NAME=
CONTACT_WHATSAPP=
CONTACT_EMAIL=
CONTACT_INSTAGRAM=
CONTACT_TELEGRAM=
CONTACT_TELEGRAM_ADMIN=
CONTACT_WEBSITE=
CONTACT_FACEBOOK=
CONTACT_LINKEDIN=
CONTACT_X=
CONTACT_YOUTUBE=
CONTACT_TIKTOK=
